# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# This file is optional - the app works with default public S3 credentials

# S3 Compatible Storage Configuration (CST Cloud)
# Optional: Override default public read-only credentials
# S3_ENDPOINT=s3.cstcloud.cn
# S3_BUCKET=32be744530ff4a4b9be7bf802bd959b8
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_USER_AGENT=S3 browser 13.1.1

# Application Configuration
# APP_FLAVOR=production
# API_BASE_URL=https://api.example.com

# Local tooling variables
# These are read from your shell environment by scripts/*.ps1 and scripts/*.py.
# Keep machine-specific absolute paths in your local shell profile; do not commit them.
